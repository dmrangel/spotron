{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spotron",
  "version": "0.1.0",
  "identifier": "dev.spotron.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spotron",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/camilladsp"]
  }
}
